    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pytest: Current File",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-s",
                "--headed"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            // to connect Playwright Inspector in Playwright Debug mode
            // "env": {
            //     "PWDEBUG": "1"
            // }
        },
        // {
        //     "name": "Python Debugger: Current File",
        //     "type": "debugpy",
        //     "request": "launch",
        //     "program": "${file}",
        //     "console": "integratedTerminal"
        // }
    ]
}